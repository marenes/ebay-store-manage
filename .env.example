# eBay developer keys: https://developer.ebay.com/my/keys
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=               # "RuName" from User Tokens page; its accept URL must point to /auth/ebay/callback
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_SELLER_USERNAME=       # your eBay username; helps tell your messages apart from the buyer's

# Supplier data (Keepa API key: https://keepa.com/#!api)
KEEPA_API_KEY=
KEEPA_DOMAIN=1              # 1 = amazon.com

PORT=3000
DATABASE_PATH=data/app.db
MESSAGE_SYNC_MINUTES=5      # buyer messages; 0 turns it off
MESSAGE_HISTORY_DAYS=90     # how far back the first message sync reaches
